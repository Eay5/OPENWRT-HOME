# ImmortalWrt 6.12 profile for x86_64 — Dedicated LUCKY Reverse Proxy & Inbound Access Gateway
# Optimized for: Lucky (DDNS, Port Forwarding, Reverse Proxy, SSL ACME, STUN Inbound Penetration)
# Cleaned: SmartDNS, HomeProxy, SQM, UPnP, Wake-on-LAN removed.

# Target
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=x86-64-v2"
CONFIG_CCACHE=y
# CONFIG_DEBUG_INFO_BTF is not set

# Package Manager — Modern APK
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-tools=y
CONFIG_PACKAGE_opkg=n

# Image
CONFIG_GRUB_IMAGES=y
CONFIG_PACKAGE_grub2-efi=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# Base tools & Diagnostics for Inbound & DDNS
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_jq=y

# VM & Network drivers (Support both VM & Physical NICs)
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-scsi=y
CONFIG_PACKAGE_kmod-virtio-rng=y
CONFIG_PACKAGE_kmod-virtio-balloon=y
CONFIG_PACKAGE_kmod-virtio-console=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-igc=y

# Hardware Crypto Acceleration (AES-NI for high throughput HTTPS/TLS termination)
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-x86=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-manager=y

# Network — Modern Firewall4 & Nftables & FullCone NAT Acceleration
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# IPv6 dual-stack support for remote inbound access without public IPv4
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_6in4=n
CONFIG_PACKAGE_luci-proto-ipv6=y

# DNS stack (Lightweight dnsmasq-full for low footprint & fast DNS query)
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnssec=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bind-host=y

# EXCLUDE: SmartDNS & MosDNS (Unused, removed as requested)
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_smartdns-ui=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=n
CONFIG_PACKAGE_mosdns=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=n

# EXCLUDE: HomeProxy & Sing-box (Unused, removed as requested)
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=n
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_sing-geoip=n
CONFIG_PACKAGE_sing-geosite=n
CONFIG_PACKAGE_ucode-mod-math=n

# EXCLUDE: SQM QoS (Unused, removed as requested)
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=n
CONFIG_PACKAGE_sqm-scripts=n
CONFIG_PACKAGE_kmod-sched-cake=n
CONFIG_PACKAGE_kmod-sched-core=n

# EXCLUDE: UPnP IGD and PCP/NAT-PMP (Unused, removed as requested)
CONFIG_PACKAGE_miniupnpd=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=n

# EXCLUDE: Wake-on-LAN (Removed as requested)
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_etherwake=n

# CORE APPLICATION: Lucky 大吉 (Latest upstream official release)
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# LuCI core & Language & Theme
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_CN=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-proto-ppp=y

# Exclude unnecessary apps
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=n
CONFIG_PACKAGE_luci-app-accesscontrol=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-ddns=n

# Performance & High Conntrack for Reverse Proxy
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tcp-hybla=y
CONFIG_PACKAGE_kmod-tcp-scalable=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nfnetlink-log=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y

# Libraries
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-ng=y
CONFIG_PACKAGE_libzstd=y
