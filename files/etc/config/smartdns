config smartdns
	option enabled '1'
	option server_name 'SmartDNS6053'
	option port '6053'
	option auto_set_dnsmasq '0'
	option tcp_server '1'
	option tls_server '0'
	option doh_server '0'
	option ipv6_server '1'
	option bind_device '1'
	option dualstack_ip_selection '1'
	option prefetch_domain '1'
	option serve_expired '1'
	option serve_expired_ttl '86400'
	option serve_expired_reply_ttl '3'
	option cache_size '32768'
	option cache_persist '1'
	option resolve_local_hostnames '1'
	option force_https_soa '1'
	option rr_ttl_min '300'
	option rr_ttl_max '86400'
	option seconddns_port '6553'
	option seconddns_tcp_server '1'
	option seconddns_force_https_soa '0'
	option log_output_mode 'file'
	option auto_update_week_time '*'
	option auto_update_day_time '0'
	option old_port '6053'
	option old_enabled '1'
	option old_auto_set_dnsmasq '0'

config domain-rule

config client-rule
	option enabled '0'
	option dualstack_ip_selection '1'
	option force_https_soa '1'

config ip-rule
	option enabled '1'

