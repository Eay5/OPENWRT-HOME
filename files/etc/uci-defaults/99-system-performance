#!/bin/sh

set -eu

if ! uci -q show network.globals >/dev/null 2>&1; then
	uci set network.globals='globals'
fi

uci -q set network.globals.packet_steering='1'
uci -q commit network

if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
fi

# Set default LuCI language to Chinese (zh_cn)
if uci -q get luci.main >/dev/null 2>&1; then
	uci -q set luci.main.lang='zh_cn'
	uci -q commit luci
fi

if [ -x /etc/init.d/performance-mode ]; then
	/etc/init.d/performance-mode enable >/dev/null 2>&1 || true
	/etc/init.d/performance-mode restart >/dev/null 2>&1 || /etc/init.d/performance-mode start >/dev/null 2>&1 || true
fi

if [ -x /etc/init.d/irqbalance ]; then
	/etc/init.d/irqbalance enable >/dev/null 2>&1 || true
	/etc/init.d/irqbalance restart >/dev/null 2>&1 || /etc/init.d/irqbalance start >/dev/null 2>&1 || true
fi

# Apply kernel 6.18 sysctl performance optimizations
cat << 'EOF' > /etc/sysctl.d/99-performance.conf
# ==============================================================================
# Linux 6.18 Kernel & Soft Router Performance Tuning
# ==============================================================================

# 1. TCP BBR & Queue discipline
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# 2. TCP Latency & Proxy Stream Tuning (Reduces bufferbloat & TLS handshake latency)
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_adv_win_scale = 1

# 3. Quick socket reuse & Keepalive cleanup (PT/BT & Proxy Connection Reclaim)
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_max_tw_buckets = 262144

# 4. Large Memory Buffers for 1G / 2.5G / 10G Throughput
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
net.core.optmem_max = 65536
net.ipv4.tcp_rmem = 4096 87380 33554432
net.ipv4.tcp_wmem = 4096 65536 33554432
net.ipv4.udp_rmem_min = 8192
net.ipv4.udp_wmem_min = 8192
net.core.netdev_max_backlog = 16384
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 8000
net.core.somaxconn = 8192

# 5. Conntrack NAT Table Scaling & Timeout Optimization (104万并发)
net.netfilter.nf_conntrack_max = 1048576
net.netfilter.nf_conntrack_tcp_timeout_established = 7200
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 15
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_udp_timeout = 30
net.netfilter.nf_conntrack_udp_timeout_stream = 120

# 6. Virtual Memory, VFS & DMA Atomic Reservation (Prevents packet drops during high bursts)
vm.swappiness = 10
vm.vfs_cache_pressure = 50
vm.min_free_kbytes = 65536
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
EOF

# 7. PassWall & MosDNS Bypass Gateway Default Tuning
# Dnsmasq: 允许作为旁路由 DNS 服务器，关闭 localservice 丢包限制
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	uci -q set dhcp.@dnsmasq[0].localservice='0'
	uci -q set dhcp.@dnsmasq[0].rebind_protection='0'
	uci -q commit dhcp
fi

# Firewall: 自动为 LAN 区域开启 IP 动态伪装与 MSS 钳制 (解决旁路由流量转发与跨网段通信)
if uci -q get firewall.lan >/dev/null 2>&1; then
	uci -q set firewall.lan.masq='1'
	uci -q set firewall.lan.mtu_fix='1'
	uci -q commit firewall
fi

# 8. SmartDNS & MosDNS Integration Tuning
# SmartDNS: 监听在 6053 端口，作为国内 DNS 加速引擎
if uci -q get smartdns.@smartdns[0] >/dev/null 2>&1; then
	uci -q set smartdns.@smartdns[0].enabled='1'
	uci -q set smartdns.@smartdns[0].port='6053'
	uci -q set smartdns.@smartdns[0].tcp_server='1'
	uci -q set smartdns.@smartdns[0].dualstack_ip_selection='1'
	uci -q set smartdns.@smartdns[0].prefetch_domain='1'
	uci -q set smartdns.@smartdns[0].serve_expired='1'
	uci -q set smartdns.@smartdns[0].cache_size='8000'
	uci -q commit smartdns
fi

# MosDNS: 将国内 DNS 与 Bootstrap 引导 DNS 指向 SmartDNS (127.0.0.1:6053)
if uci -q get mosdns.config >/dev/null 2>&1; then
	uci -q set mosdns.config.enabled='1'
	uci -q set mosdns.config.listen_port='5335'
	uci -q set mosdns.config.bootstrap_dns='127.0.0.1:6053'
	uci -q set mosdns.config.local_dns='127.0.0.1:6053'
	uci -q commit mosdns
elif uci -q get mosdns.@mosdns[0] >/dev/null 2>&1; then
	uci -q set mosdns.@mosdns[0].enabled='1'
	uci -q set mosdns.@mosdns[0].listen_port='5335'
	uci -q set mosdns.@mosdns[0].bootstrap_dns='127.0.0.1:6053'
	uci -q set mosdns.@mosdns[0].local_dns='127.0.0.1:6053'
	uci -q commit mosdns
fi

# Clean non-existent snapshot package repos (helloworld, video)
sed -i '/helloworld/d;/video/d;/passwall/d' /etc/apk/repositories.d/* /etc/apk/repositories /etc/opkg/distfeeds.conf 2>/dev/null || true

sysctl -p /etc/sysctl.d/99-performance.conf >/dev/null 2>&1 || true

exit 0
