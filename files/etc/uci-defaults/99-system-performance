#!/bin/sh

# OpenWrt uci-defaults 首次启动配置脚本
# 注意：避免使用 set -e / set -u，防止个别非关键配置异常中断脚本执行导致系统每次重启都重复执行该脚本。

if ! uci -q show network.globals >/dev/null 2>&1; then
	uci set network.globals='globals'
fi

uci -q set network.globals.packet_steering='1'

# 彻底关闭 IPv6
if uci -q get network.lan >/dev/null 2>&1; then
	uci -q set network.lan.ipv6='0'
	uci -q set network.lan.delegate='0'
fi
uci -q del network.lan6 2>/dev/null || true
uci -q del network.wan6 2>/dev/null || true
uci -q commit network

# 关闭 DHCP 服务的 IPv6 通告 (DHCPv6 & RA)
if uci -q get dhcp.lan >/dev/null 2>&1; then
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ra='disabled'
	uci -q commit dhcp
fi

if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q set firewall.@defaults[0].forward='ACCEPT'
	uci -q set firewall.@defaults[0].syn_flood='0'
	uci -q commit firewall
fi

# Set default LuCI language to Chinese (zh_cn)
if uci -q get luci.main >/dev/null 2>&1; then
	uci -q set luci.main.lang='zh_cn'
	uci -q commit luci
fi

if [ -x /etc/init.d/performance-mode ]; then
	/etc/init.d/performance-mode enable >/dev/null 2>&1 || true
	/etc/init.d/performance-mode restart >/dev/null 2>&1 || /etc/init.d/performance-mode start >/dev/null 2>&1 || true
fi

if [ -x /etc/init.d/irqbalance ]; then
	/etc/init.d/irqbalance enable >/dev/null 2>&1 || true
	/etc/init.d/irqbalance restart >/dev/null 2>&1 || /etc/init.d/irqbalance start >/dev/null 2>&1 || true
fi

# Apply kernel 6.12 / 6.18 sysctl performance optimizations
cat << 'EOF' > /etc/sysctl.d/99-performance.conf
# ==============================================================================
# Linux 6.12 / 6.18 Kernel & Soft Router Performance Tuning
# ==============================================================================

# 1. TCP BBR & Queue discipline
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# 2. TCP Latency & Proxy Stream Tuning (Reduces bufferbloat & TLS handshake latency)
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_adv_win_scale = 1
net.ipv4.tcp_max_syn_backlog = 16384

# 3. Quick socket reuse & Keepalive cleanup (PT/BT & Proxy Connection Reclaim)
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_max_tw_buckets = 262144

# 4. Large Memory Buffers for 1G / 2.5G / 10G Throughput
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
net.core.optmem_max = 65536
net.ipv4.tcp_rmem = 4096 87380 33554432
net.ipv4.tcp_wmem = 4096 65536 33554432
net.ipv4.udp_rmem_min = 8192
net.ipv4.udp_wmem_min = 8192
net.core.netdev_max_backlog = 16384
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 8000
net.core.somaxconn = 8192

# 5. Conntrack NAT Table Scaling & Timeout Optimization (104万并发)
net.netfilter.nf_conntrack_max = 1048576
net.netfilter.nf_conntrack_tcp_timeout_established = 7200
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 15
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_udp_timeout = 30
net.netfilter.nf_conntrack_udp_timeout_stream = 120

# 6. ARP / Neighbor Table Scaling (Prevents overflow in VM/Docker/Dense LAN)
net.ipv4.neigh.default.gc_thresh1 = 2048
net.ipv4.neigh.default.gc_thresh2 = 4096
net.ipv4.neigh.default.gc_thresh3 = 8192

# 7. File Descriptors & Memory / DMA Tuning (Prevents packet drops during high bursts)
fs.file-max = 2097152
fs.nr_open = 2097152
vm.swappiness = 10
vm.vfs_cache_pressure = 50
vm.min_free_kbytes = 65536
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5

# 8. IPv6 Global Disable (全局彻底禁用 IPv6，规避双栈 DNS 污染与旁路泄露)
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1

# 9. Bypass Gateway Optimization (旁路由单臂单网口防分流失效与非对称丢包优化)
# 彻底关闭 ICMP 重定向，防止内网终端被提示绕过旁路由导致 HomeProxy 透明代理失效
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# 放宽反向路径过滤 (Loose Mode)，解决旁路由单臂进出与非对称分流被静默丢弃
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2

# 开启 Linux 6.12 / 6.18 原生 UDP GRO 转发加速，提升单臂双倍吞吐性能
net.ipv4.udp_gro_forwarding = 1
net.ipv4.ip_forward = 1
EOF

# 7. HomeProxy & Bypass Gateway Default Tuning
# Dnsmasq: 接驳 HomeProxy Sing-Box DNS (127.0.0.1#5333) 实现智能国内外分流，保持动态 min_cache_ttl 为 0，保留 WAN 上游容灾，关闭 localservice 丢包限制，过滤 IPv6 AAAA 记录，设置 10000 缓存
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	uci -q del dhcp.@dnsmasq[0].server 2>/dev/null || true
	uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#5333'
	uci -q del dhcp.@dnsmasq[0].noresolv 2>/dev/null || true
	uci -q set dhcp.@dnsmasq[0].min_cache_ttl='0'
	uci -q set dhcp.@dnsmasq[0].localservice='0'
	uci -q set dhcp.@dnsmasq[0].rebind_protection='0'
	uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'
	uci -q set dhcp.@dnsmasq[0].cachesize='10000'
	uci -q commit dhcp
fi

# 全局彻底禁用 IPv6 网络接口与 ULA 前缀 (纯 IPv4 极速环境，彻底杜绝 IPv6 旁路干扰)
uci -q del network.globals.ula_prefix 2>/dev/null || true
uci -q del network.wan6 2>/dev/null || true
if uci -q get network.lan >/dev/null 2>&1; then
	uci -q set network.lan.ipv6='0'
	uci -q del network.lan.ip6assign 2>/dev/null || true
	uci -q del network.lan.ip6hint 2>/dev/null || true
	uci -q set network.lan.delegate='0'
fi
if uci -q get network.wan >/dev/null 2>&1; then
	uci -q set network.wan.ipv6='0'
	uci -q set network.wan.delegate='0'
fi
uci -q commit network

# 禁用 LAN / WAN 口 IPv6 路由通告 (RA) 与 DHCPv6 分发，禁用 odhcpd 服务
if uci -q get dhcp.lan >/dev/null 2>&1; then
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ra='disabled'
	uci -q set dhcp.lan.ndp='disabled'
	uci -q del dhcp.lan.dns 2>/dev/null || true

	# 旁路由防冲突：单网口虚拟机/旁路由环境默认关闭 IPv4 DHCP 分配，严禁插电瞬间与主路由抢答引起局域网瘫痪
	eth_count="$(ls /sys/class/net 2>/dev/null | grep -cE '^(eth|en|vi)[0-9]+' || true)"
	if [ "${eth_count:-0}" -le 1 ] && ! uci -q get network.wan.device >/dev/null 2>&1; then
		uci -q set dhcp.lan.ignore='1'
	fi
fi
if uci -q get dhcp.wan >/dev/null 2>&1; then
	uci -q set dhcp.wan.dhcpv6='disabled'
	uci -q set dhcp.wan.ra='disabled'
	uci -q set dhcp.wan.ndp='disabled'
fi
if uci -q get dhcp.odhcpd >/dev/null 2>&1; then
	uci -q set dhcp.odhcpd.maindhcp='0'
fi
uci -q commit dhcp

if [ -x /etc/init.d/odhcpd ]; then
	/etc/init.d/odhcpd disable >/dev/null 2>&1 || true
	/etc/init.d/odhcpd stop >/dev/null 2>&1 || true
fi

# HomeProxy 出厂最佳预设（TUN 模式、大陆白名单、全端口代理、国外 DNS 采用 DoH https://dns.google/dns-query，国内 DNS 接驳 SmartDNS 6053 毫秒级缓存）
if uci -q get homeproxy.config >/dev/null 2>&1; then
	uci -q set homeproxy.config.dns_server='https://dns.google/dns-query'
	uci -q set homeproxy.config.china_dns_server='udp://127.0.0.1:6053'
	uci -q set homeproxy.config.routing_mode='bypass_mainland_china'
	uci -q set homeproxy.config.proxy_mode='tun'
	uci -q set homeproxy.config.routing_port='all'
	uci -q set homeproxy.config.ipv6_support='0'
	uci -q commit homeproxy
fi
if uci -q get homeproxy.routing >/dev/null 2>&1; then
	uci -q set homeproxy.routing.sniff_override='1'
	uci -q set homeproxy.routing.default_outbound='direct-out'
	uci -q set homeproxy.routing.default_outbound_dns='default-dns'
	uci -q commit homeproxy
fi

# Firewall: 旁路由核心调优（LAN 开启动态伪装 NAT、MSS 钳制、允许全向转发）
if uci -q get firewall.lan >/dev/null 2>&1; then
	uci -q set firewall.lan.masq='1'
	uci -q set firewall.lan.mtu_fix='1'
	uci -q set firewall.lan.input='ACCEPT'
	uci -q set firewall.lan.output='ACCEPT'
	uci -q set firewall.lan.forward='ACCEPT'
	uci -q commit firewall
fi

# Firewall: 拦截/拒绝外网 UDP 443 (QUIC/HTTP3)，强制全网设备 YouTube/Google 回退极速稳定的 TCP，彻底根除 ERR_SSL_VERSION_OR_CIPHER_MISMATCH
if ! uci -q get firewall.block_quic >/dev/null 2>&1; then
	uci -q set firewall.block_quic='rule'
	uci -q set firewall.block_quic.name='Block-QUIC-UDP443'
	uci -q set firewall.block_quic.src='lan'
	uci -q set firewall.block_quic.proto='udp'
	uci -q set firewall.block_quic.dest_port='443'
	uci -q set firewall.block_quic.target='REJECT'
	uci -q commit firewall
fi

# 8. SmartDNS Full-RAM Performance Tuning (13.1万条纯内存极速响应，彻底关闭 IPv6 与双栈测速)
if uci -q get smartdns.@smartdns[0] >/dev/null 2>&1; then
	uci -q set smartdns.@smartdns[0].enabled='1'
	uci -q set smartdns.@smartdns[0].port='6053'
	uci -q set smartdns.@smartdns[0].tcp_server='1'
	uci -q set smartdns.@smartdns[0].ipv6_server='0'
	uci -q set smartdns.@smartdns[0].dualstack_ip_selection='0'
	uci -q set smartdns.@smartdns[0].force_aaaa_soa='1'
	uci -q set smartdns.@smartdns[0].prefetch_domain='1'
	uci -q set smartdns.@smartdns[0].serve_expired='1'
	uci -q set smartdns.@smartdns[0].serve_expired_ttl='86400'
	uci -q set smartdns.@smartdns[0].serve_expired_reply_ttl='3'
	uci -q set smartdns.@smartdns[0].speed_check_mode='tcp:443,tcp:80,ping'
	uci -q set smartdns.@smartdns[0].cache_size='131072'
	uci -q set smartdns.@smartdns[0].cache_file='/tmp/smartdns.cache'
	uci -q set smartdns.@smartdns[0].cache_persist='1'
	uci -q set smartdns.@smartdns[0].force_https_soa='1'
	uci -q set smartdns.@smartdns[0].rr_ttl_min='300'
	uci -q set smartdns.@smartdns[0].rr_ttl_max='86400'
	uci -q set smartdns.@smartdns[0].seconddns_enabled='0'
	uci -q del smartdns.@smartdns[0].seconddns_port 2>/dev/null || true
	uci -q del smartdns.@smartdns[0].seconddns_tcp_server 2>/dev/null || true
	uci -q del smartdns.@smartdns[0].seconddns_force_https_soa 2>/dev/null || true
	uci -q commit smartdns
fi

# 9. 开启开机热点域名内存预热服务 (DNS Pre-warming)
if [ -x /etc/init.d/dns-preload ]; then
	/etc/init.d/dns-preload enable >/dev/null 2>&1 || true
fi

# Clean non-existent snapshot package repos (helloworld, video, passwall, mosdns)
sed -i '/helloworld/d;/video/d;/passwall/d;/mosdns/d' /etc/apk/repositories.d/* /etc/apk/repositories /etc/opkg/distfeeds.conf 2>/dev/null || true

sysctl -p /etc/sysctl.d/99-performance.conf >/dev/null 2>&1 || true

exit 0
