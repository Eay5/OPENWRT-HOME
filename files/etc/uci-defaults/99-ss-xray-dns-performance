#!/bin/sh

set -eu

MOSDNS_PORT="5335"
SMARTDNS_PORT="6053"

if ! uci -q show smartdns | grep -q "=smartdns"; then
	uci add smartdns smartdns >/dev/null
fi

if ! uci -q show mosdns.config >/dev/null 2>&1; then
	uci set mosdns.config='mosdns'
fi

# 让 LAN 侧 IPv6 客户端继续把路由器当作 DNS 入口，避免直接拿上游 DNS 绕过本机链路。
uci -q set dhcp.lan.ra_dns='1'
uci -q set dhcp.lan.dns_service='1'
uci -q delete dhcp.lan.dns

uci -q batch <<EOF
set dhcp.@dnsmasq[0].cachesize='0'
set dhcp.@dnsmasq[0].noresolv='1'
delete dhcp.@dnsmasq[0].server
add_list dhcp.@dnsmasq[0].server='127.0.0.1#${MOSDNS_PORT}'
add_list dhcp.@dnsmasq[0].server='::1#${MOSDNS_PORT}'

set smartdns.@smartdns[0].enabled='1'
set smartdns.@smartdns[0].port='${SMARTDNS_PORT}'
set smartdns.@smartdns[0].tcp_server='1'
set smartdns.@smartdns[0].prefetch_domain='1'
set smartdns.@smartdns[0].serve_expired='1'
set smartdns.@smartdns[0].cache_size='20000'
set smartdns.@smartdns[0].cache_persist='1'
set smartdns.@smartdns[0].dualstack_ip_selection='0'
set smartdns.@smartdns[0].force_aaaa_soa='1'
set smartdns.@smartdns[0].speed_check_mode='tcp:443,tcp:80'
set smartdns.@smartdns[0].rr_ttl_min='300'
set smartdns.@smartdns[0].rr_ttl_max='3600'
set smartdns.@smartdns[0].rr_ttl_reply_max='60'
set smartdns.@smartdns[0].response_mode='fastest-ip'

set mosdns.config.enabled='1'
set mosdns.config.listen_port='${MOSDNS_PORT}'
set mosdns.config.redirect='1'
set mosdns.config.custom_local_dns='1'
delete mosdns.config.local_dns
add_list mosdns.config.local_dns='127.0.0.1:${SMARTDNS_PORT}'
set mosdns.config.bootstrap_dns='127.0.0.1:${SMARTDNS_PORT}'
delete mosdns.config.remote_dns
add_list mosdns.config.remote_dns='tls://8.8.8.8'
add_list mosdns.config.remote_dns='tls://1.1.1.1'
set mosdns.config.cache='1'
set mosdns.config.cache_size='8192'
set mosdns.config.lazy_cache_ttl='86400'
set mosdns.config.adblock='0'
set mosdns.config.custom_stream_media_dns='0'
EOF

if ! uci -q get smartdns.@bind[0] >/dev/null 2>&1; then
	b_idx=$(uci add smartdns bind)
	uci -q set smartdns.${b_idx}.enabled='1'
	uci -q set smartdns.${b_idx}.name='default'
	uci -q set smartdns.${b_idx}.bind_dns_over_udp='1'
	uci -q set smartdns.${b_idx}.bind_dns_over_tcp='1'
	uci -q set smartdns.${b_idx}.port="${SMARTDNS_PORT}"
else
	uci -q set smartdns.@bind[0].enabled='1'
	uci -q set smartdns.@bind[0].name='default'
	uci -q set smartdns.@bind[0].bind_dns_over_udp='1'
	uci -q set smartdns.@bind[0].bind_dns_over_tcp='1'
	uci -q set smartdns.@bind[0].port="${SMARTDNS_PORT}"
fi

uci -q delete smartdns.@smartdns[0].server || true
while uci -q delete smartdns.@server[0] >/dev/null 2>&1; do :; done

for ip in \
	"202.103.24.68" \
	"202.103.44.150" \
	"202.103.0.117" \
	"202.103.0.68" \
	"119.28.28.28" \
	"119.29.29.29" \
	"223.5.5.5" \
	"223.6.6.6" \
	"180.76.76.76" \
	"180.184.1.1" \
	"180.184.2.2" \
	"101.226.4.6" \
	"218.30.118.6" \
	"114.114.114.114" \
	"210.2.4.8" \
	"1.2.4.8"
do
	s_idx=$(uci add smartdns server)
	uci -q set smartdns.${s_idx}.enabled='1'
	uci -q set smartdns.${s_idx}.name="${ip}"
	uci -q set smartdns.${s_idx}.type='udp'
	uci -q set smartdns.${s_idx}.ip="${ip}"
done

uci -q commit dhcp
uci -q commit smartdns
uci -q commit mosdns

/etc/init.d/smartdns enable >/dev/null 2>&1 || true
/etc/init.d/smartdns restart >/dev/null 2>&1 || true
/etc/init.d/mosdns enable >/dev/null 2>&1 || true
/etc/init.d/mosdns restart >/dev/null 2>&1 || true
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true

exit 0
