#!/bin/sh /etc/rc.common

START=96

boot() {
	start
}

start() {
	(
		# 等待 SmartDNS 启动就绪 (最多等待 15 秒)
		for i in $(seq 1 15); do
			if nc -z 127.0.0.1 6053 >/dev/null 2>&1 || netstat -uln 2>/dev/null | grep -q ':6053 '; then
				break
			fi
			sleep 1
		done

		# ======================================================================
		# 国内高频核心域名 & 镜像加速站清单（开机纯内存秒级注水，100% 纯净直连）
		# ======================================================================

		# 1. 常用国内镜像源与代码托管
		mirror_domains="gitee.com \
		registry.npmmirror.com \
		mirrors.tuna.tsinghua.edu.cn \
		mirrors.aliyun.com \
		mirrors.ustc.edu.cn \
		pypi.doubanio.com \
		goproxy.cn \
		dockerproxy.cn \
		mirror.baidubce.com"

		# 2. 国内高频生活与主流云生态 + 核心网页静态资源 CDN 与满速下载 CDN 节点域名
		#    涵盖图片流 (小红书/B站/淘宝/京东)、大文件网盘、Apple/微软/Steam 下载 CDN，点开即刻 0ms 内存命中
		daily_domains="qq.com weixin.qq.com wx.qq.com qpic.cn qlogo.cn gtimg.cn gtimg.com myqcloud.com cdn-go.cn \
		taobao.com alipay.com tmall.com alicdn.com tbcdn.cn aliyun.com aliyuncs.com alipayobjects.com tenpay.com \
		jd.com 360buyimg.com jdcdn.com jcloud.com \
		douyin.com bytedance.com byteimg.com bytegoofy.com pstatp.com snssdk.com \
		bilibili.com hdslb.com bilivideo.com biligame.com \
		baidu.com bdimg.com bdstatic.com baidupcs.com pcs.baidu.com \
		zhihu.com zhimg.com 163.com 126.net netease.com music.163.com ydstatic.com \
		sina.com.cn sinaimg.cn weibo.com weibo.cn xiaohongshu.com xhscdn.com \
		meituan.com meituan.net dianping.com ele.me \
		iqiyi.com qiyipic.com youku.com y.qq.com \
		apple.com icloud.com apple-dns.net mzstatic.com cdn-apple.com aaplimg.com init.push.apple.com \
		microsoft.com live.com office.com msedge.net windowsupdate.com delivery.mp.microsoft.com s-microsoft.com \
		steamcontent.com steamstatic.com akamaized.net \
		xiaomi.com mi.com miui.com huawei.com dbankcdn.com vmall.com honor.cn oppo.com vivo.com \
		game.qq.com miHoYo.com hoyoverse.com speedtest.cn \
		v2ex.com juejin.cn csdn.net segmentfault.com"

		all_domains="${mirror_domains} ${daily_domains}"

		# 并发静默预热：
		# 直接向 SmartDNS 6053 端口发起并发查询，避免开机初期 Dnsmasq (53) -> Sing-box (5333) 尚未就绪导致预热失败，
		# 确保解析结果在开机瞬间 100% 注满 SmartDNS 纯内存 Hash 表
		for domain in $all_domains; do
			if command -v dig >/dev/null 2>&1; then
				dig @127.0.0.1 -p 6053 +time=2 +tries=1 "$domain" A >/dev/null 2>&1 &
			else
				nslookup -port=6053 "$domain" 127.0.0.1 >/dev/null 2>&1 || nslookup "$domain" 127.0.0.1:6053 >/dev/null 2>&1 &
			fi
		done
	) >/dev/null 2>&1 &
}
