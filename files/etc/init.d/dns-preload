#!/bin/sh /etc/rc.common

START=96

boot() {
	start
}

start() {
	(
		# 等待 SmartDNS 启动就绪 (最多等待 15 秒)
		for i in $(seq 1 15); do
			if nc -z 127.0.0.1 6053 >/dev/null 2>&1 || netstat -uln 2>/dev/null | grep -q ':6053 '; then
				break
			fi
			sleep 1
		done

		# ======================================================================
		# 国内高频核心域名 & 镜像加速站清单（开机纯内存秒级注水，100% 纯净直连）
		# ======================================================================

		# 1. 常用国内镜像源与代码托管
		mirror_domains="gitee.com \
		registry.npmmirror.com \
		mirrors.tuna.tsinghua.edu.cn \
		mirrors.aliyun.com \
		mirrors.ustc.edu.cn \
		pypi.doubanio.com \
		goproxy.cn \
		dockerproxy.cn \
		mirror.baidubce.com"

		# 2. 国内高频生活与主流云生态 (微信/阿里/京东/抖音/B站/百度/网易/美团/苹果/微软)
		daily_domains="qq.com weixin.qq.com wx.qq.com qpic.cn qlogo.cn gtimg.cn \
		taobao.com alipay.com tmall.com alicdn.com aliyun.com \
		jd.com 360buyimg.com jcloud.com \
		douyin.com bytedance.com byteimg.com pstatp.com \
		bilibili.com hdslb.com bilivideo.com \
		baidu.com bdimg.com bdstatic.com \
		zhihu.com zhimg.com 163.com 126.net netease.com \
		sina.com.cn weibo.com xiaohongshu.com \
		meituan.com dianping.com ele.me \
		apple.com icloud.com apple-dns.net \
		microsoft.com live.com office.com \
		v2ex.com juejin.cn segmentfault.com"

		all_domains="${mirror_domains} ${daily_domains}"

		# 并发静默预热，将解析结果直接注满 SmartDNS 纯内存 Hash 表
		for domain in $all_domains; do
			nslookup "$domain" 127.0.0.1 >/dev/null 2>&1 &
		done
	) >/dev/null 2>&1 &
}
