#!/bin/sh /etc/rc.common

START=95

# 返回可用于调度和网卡队列分流的 CPU 核心数。
get_cpu_count() {
	local count

	count="$(nproc 2>/dev/null || true)"
	case "$count" in
		''|*[!0-9]*)
			count="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"
			;;
	esac

	case "$count" in
		''|*[!0-9]*|0)
			count=1
			;;
	esac

	echo "$count"
}

# 按 CPU 核心数生成十六进制掩码，给 RPS/XPS 和 IRQ 亲和设置使用。
build_cpu_mask() {
	local count="$1"
	local chunk_hex
	local mask=""

	while [ "$count" -gt 0 ]; do
		if [ "$count" -ge 32 ]; then
			chunk_hex="ffffffff"
			count=$((count - 32))
		else
			chunk_hex="$(printf '%x' $(((1 << count) - 1)))"
			count=0
		fi

		if [ -n "$mask" ]; then
			mask="${chunk_hex},${mask}"
		else
			mask="$chunk_hex"
		fi
	done

	echo "$mask"
}

# 判断当前是否为 Intel 处理器，避免把 Intel 专属参数写到其它 CPU 的 sysfs 节点。
is_intel_cpu() {
	grep -q 'vendor_id[[:space:]]*:[[:space:]]*GenuineIntel' /proc/cpuinfo 2>/dev/null
}

# 把 CPU governor 和 EPP 拉到性能档，减少路由场景下的突发降频。
apply_cpu_governor() {
	local available_file epp_file governor_file

	for governor_file in \
		/sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
		/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -f "$governor_file" ] || continue

		available_file="${governor_file%/*}/scaling_available_governors"
		if [ -f "$available_file" ] && grep -qw performance "$available_file"; then
			echo performance >"$governor_file" 2>/dev/null || true
		fi
	done

	for epp_file in \
		/sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference \
		/sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
		[ -f "$epp_file" ] || continue

		available_file="${epp_file%/*}/energy_performance_available_preferences"
		if [ -f "$available_file" ] && grep -qw performance "$available_file"; then
			echo performance >"$epp_file" 2>/dev/null || true
		fi
	done
}

# 针对 Intel/AMD P-State、HWP 与 CPU C-States 深睡眠做满血低延迟优化：
# 1. 放开 Turbo 睿频 (no_turbo=0 / boost=1)；
# 2. 拉满最高与最低性能百分比 (max_perf_pct=100, min_perf_pct=100)，消除 HWP 空闲降频爬坡延迟；
# 3. 打开 HWP dynamic boost；
# 4. 把 energy_perf_bias 设为 0，优先性能而不是省电；
# 5. 禁用唤醒延迟 > 30us 的深层 C-States (C6/C8/C10)，杜绝 Intel i225/i226 / Realtek 2.5G 网卡唤醒抖动。
apply_intel_pstate_tweaks() {
	local epb_file state_dir latency
	local pstate_dir="/sys/devices/system/cpu/intel_pstate"

	# 开启通用 cpufreq boost (兼容 AMD P-State / acpi-cpufreq)
	[ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 >/sys/devices/system/cpu/cpufreq/boost 2>/dev/null || true

	if is_intel_cpu && [ -d "$pstate_dir" ]; then
		[ -f "$pstate_dir/max_perf_pct" ] && echo 100 >"$pstate_dir/max_perf_pct" 2>/dev/null || true
		[ -f "$pstate_dir/min_perf_pct" ] && echo 100 >"$pstate_dir/min_perf_pct" 2>/dev/null || true
		[ -f "$pstate_dir/no_turbo" ] && echo 0 >"$pstate_dir/no_turbo" 2>/dev/null || true
		[ -f "$pstate_dir/hwp_dynamic_boost" ] && echo 1 >"$pstate_dir/hwp_dynamic_boost" 2>/dev/null || true

		for epb_file in /sys/devices/system/cpu/cpu*/power/energy_perf_bias; do
			[ -f "$epb_file" ] || continue
			echo 0 >"$epb_file" 2>/dev/null || true
		done
	fi

	# 禁用唤醒延迟 > 30 微秒的深层 CPU C-States (如 C6 / C8 / C10)，仅保留 C0/C1/C1E 浅层睡眠
	for state_dir in /sys/devices/system/cpu/cpu*/cpuidle/state*; do
		[ -f "$state_dir/latency" ] && [ -w "$state_dir/disable" ] || continue
		latency="$(cat "$state_dir/latency" 2>/dev/null || echo 0)"
		case "$latency" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$latency" -gt 30 ]; then
			echo 1 >"$state_dir/disable" 2>/dev/null || true
		fi
	done
}

# 提前加载 TCP 拥塞控制模块，让 Turbo ACC 或 sysctl 能看到 BBR/Hybla/Scalable。
load_tcp_congestion_modules() {
	local module

	for module in tcp_bbr tcp_hybla tcp_scalable; do
		modprobe "$module" >/dev/null 2>&1 || true
	done
}

# 调整网络栈参数，解决物理机高 PPS 或多队列网卡下包处理预算偏小的问题。
apply_sysctl_tweaks() {
	local hash_file

	load_tcp_congestion_modules

	# 调大系统全局与进程打开文件句柄数限制，杜绝高并发代理/DNS丢连接
	sysctl -w fs.file-max=2097152 >/dev/null 2>&1 || true
	sysctl -w fs.nr_open=2097152 >/dev/null 2>&1 || true
	ulimit -n 1048576 2>/dev/null || true

	# Linux 6.18 EEVDF 调度器与多核物理机低延迟优化：
	# 关闭桌面级会话自动分组 (sched_autogroup) 与 NUMA 自动迁移扫描，消除 Sing-box / SmartDNS 守护进程被限权或跨核迁移抖动
	sysctl -w kernel.sched_autogroup_enabled=0 >/dev/null 2>&1 || true
	sysctl -w kernel.numa_balancing=0 >/dev/null 2>&1 || true
	# 开启 BPF JIT 即时编译并设为纯内核态 JIT，加速 nftables/fw4 与内核网络过滤路径
	sysctl -w net.core.bpf_jit_enable=1 >/dev/null 2>&1 || true
	sysctl -w net.core.bpf_jit_harden=0 >/dev/null 2>&1 || true
	# 开启网络栈 Busy Polling (50us)，显著降低 Sing-box / SmartDNS epoll 收包唤醒尾延迟 (P99)
	sysctl -w net.core.busy_poll=50 >/dev/null 2>&1 || true
	sysctl -w net.core.busy_read=50 >/dev/null 2>&1 || true
	# 关闭 nf_conntrack 实时流量字节/包计数统计 (acct=0)，每个数据包转发少一次原子锁自增，降低高并发 NAT CPU 开销
	sysctl -w net.netfilter.nf_conntrack_acct=0 >/dev/null 2>&1 || true
	# 禁用 TCP 指标历史缓存，防止单次偶发丢包或拥塞把慢速窗口阈值缓存给后续新建连接
	sysctl -w net.ipv4.tcp_no_metrics_save=1 >/dev/null 2>&1 || true
	# 开启 MPTCP 多路径 TCP 支持 (Linux 6.18 原生特性)
	sysctl -w net.mptcp.enabled=1 >/dev/null 2>&1 || true

	# 调大 Conntrack Hash 桶深至 262144 (对应 104 万最大连接，保证 1:4 黄金哈希命中率，消除 CPU 查表瓶颈)
	for hash_file in /sys/module/nf_conntrack/parameters/hashsize /proc/sys/net/netfilter/nf_conntrack_buckets; do
		[ -f "$hash_file" ] || continue
		echo 262144 >"$hash_file" 2>/dev/null || true
	done

	# 调大 ARP / 邻居表容量，彻底防止大局域网/多设备/VM/容器环境下的邻居表溢出丢包
	sysctl -w net.ipv4.neigh.default.gc_thresh1=2048 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.neigh.default.gc_thresh2=4096 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.neigh.default.gc_thresh3=8192 >/dev/null 2>&1 || true

	# 扩充本地临时端口范围（5.5万端口）与 TIME_WAIT 桶容量，防止 Sing-box 代理高并发向外建连时端口耗尽
	sysctl -w net.ipv4.ip_local_port_range="10240 65535" >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_max_tw_buckets=262144 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_tw_reuse=1 >/dev/null 2>&1 || true
	# 开启 nf_conntrack 宽松模式，防止旁路由单臂非对称流或 Sing-box TUN 重启瞬间已有连接被误判无效丢弃
	sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true

	sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || true
	sysctl -w net.core.somaxconn=8192 >/dev/null 2>&1 || true
	sysctl -w net.core.rmem_max=33554432 >/dev/null 2>&1 || true
	sysctl -w net.core.wmem_max=33554432 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_fastopen=3 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_mtu_probing=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_notsent_lowat=16384 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_max_syn_backlog=16384 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_comp_sack=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_moderate_rcvbuf=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_fin_timeout=15 >/dev/null 2>&1 || true
	sysctl -w net.ipv4.tcp_keepalive_time=300 >/dev/null 2>&1 || true
	sysctl -w net.core.netdev_max_backlog=16384 >/dev/null 2>&1 || true
	sysctl -w net.core.netdev_budget=600 >/dev/null 2>&1 || true
	sysctl -w net.core.netdev_budget_usecs=8000 >/dev/null 2>&1 || true
	sysctl -w net.core.gro_normal_batch=8 >/dev/null 2>&1 || true
	sysctl -w vm.swappiness=10 >/dev/null 2>&1 || true
	sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1 || true
	sysctl -w vm.min_free_kbytes=65536 >/dev/null 2>&1 || true

	# 全局彻底禁用 IPv6
	sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true
	sysctl -w net.ipv6.conf.lo.disable_ipv6=1 >/dev/null 2>&1 || true
}

# 提前把默认 IRQ 亲和范围放开到全部核心，避免多队列网卡的中断长时间偏在 CPU0。
apply_irq_affinity_defaults() {
	local cpu_count cpu_mask

	cpu_count="$(get_cpu_count)"
	[ "$cpu_count" -gt 1 ] || return 0

	cpu_mask="$(build_cpu_mask "$cpu_count")"
	[ -f /proc/irq/default_smp_affinity ] && echo "$cpu_mask" >/proc/irq/default_smp_affinity 2>/dev/null || true
}

# 优化 PCIe 电源策略与物理网卡硬件缓冲，消除 2.5G/10G 网卡断流抖动与突发丢包
apply_nic_hardware_tuning() {
	local iface dev
	command -v ethtool >/dev/null 2>&1 || return 0

	# 锁定 PCIe ASPM 为高性能模式，防止 Intel i225/i226 / Realtek 8125 节能抖动
	for aspm_file in /sys/module/pcie_aspm/parameters/policy; do
		[ -f "$aspm_file" ] || continue
		echo performance >"$aspm_file" 2>/dev/null || true
	done

	for iface in /sys/class/net/*; do
		[ -d "$iface" ] || continue
		dev="${iface##*/}"

		# 为 HomeProxy / Sing-box 的 TUN 虚拟网卡 (singtun0 / tun*) 扩充发送队列至 4096（默认仅 500），
		# 根除千兆/2.5G 透明代理高并发测速、PT 下载时的虚拟网卡队列满丢包 (tx_dropped)
		case "$dev" in
			tun*|singtun*)
				ip link set dev "$dev" txqueuelen 4096 >/dev/null 2>&1 || true
				continue
				;;
			lo|veth*|br-*|docker*|tap*|ppp*|wg*)
				continue
				;;
		esac

		# 扩容网卡硬件环形缓冲区 (Ring Buffer)
		ethtool -G "$dev" rx 4096 tx 4096 >/dev/null 2>&1 || ethtool -G "$dev" rx 2048 tx 2048 >/dev/null 2>&1 || true

		# 开启硬件卸载与 UDP GRO 加速
		ethtool -K "$dev" rx on tx on tso on gso on gro on rx-udp-gro-forwarding on >/dev/null 2>&1 || true

		# 开启自适应中断合并 (Adaptive IRQ Coalescing)，在高吞吐时大幅降低软中断 CPU 占用
		ethtool -C "$dev" adaptive-rx on adaptive-tx on >/dev/null 2>&1 || true

		# 扩充网卡发送队列长度至 4096，根除突发高并发时的 tx drop 排队溢出丢包
		ip link set dev "$dev" txqueuelen 4096 >/dev/null 2>&1 || true

		# 开启 Linux 6.12 / 6.18 原生 BIG TCP 超大数据包聚合 (512KB)，提升 2.5G/5G/10G 吞吐并削减 CPU 软中断
		ip link set dev "$dev" gro_max_size 524288 gso_max_size 524288 >/dev/null 2>&1 || true

		# 开启 Linux 6.x NAPI 软中断延迟挂起 (IRQ Deferral) 与 GRO 批量刷新超时 (20us)，
		# 在持续高速流量下保持 NAPI 轮询态而无需频繁重开硬件中断，削减 15%~30% 软中断 (%si) CPU 占用且仅引入 20 微秒级聚合窗口
		[ -w "$iface/napi_defer_hard_irqs" ] && echo 2 >"$iface/napi_defer_hard_irqs" 2>/dev/null || true
		[ -w "$iface/gro_flush_timeout" ] && echo 20000 >"$iface/gro_flush_timeout" 2>/dev/null || true
	done
}

# 为每个网卡队列设置 RPS/XPS 和 flow entries，减少单核心吃满时的软中断瓶颈。
apply_queue_tuning() {
	local cpu_count cpu_mask flow_cnt iface rx_queue rx_queue_count tx_queue

	cpu_count="$(get_cpu_count)"
	[ "$cpu_count" -gt 1 ] || return 0

	cpu_mask="$(build_cpu_mask "$cpu_count")"
	sysctl -w net.core.rps_sock_flow_entries=32768 >/dev/null 2>&1 || true

	for iface in /sys/class/net/*; do
		[ -d "$iface" ] || continue

		case "${iface##*/}" in
			lo)
				continue
				;;
		esac

		rx_queue_count=0
		for rx_queue in "$iface"/queues/rx-*; do
			[ -f "$rx_queue/rps_cpus" ] || continue
			echo "$cpu_mask" >"$rx_queue/rps_cpus" 2>/dev/null || true
			rx_queue_count=$((rx_queue_count + 1))
		done

		if [ "$rx_queue_count" -gt 0 ]; then
			flow_cnt=$((32768 / rx_queue_count))
			[ "$flow_cnt" -ge 256 ] || flow_cnt=256

			for rx_queue in "$iface"/queues/rx-*; do
				[ -f "$rx_queue/rps_flow_cnt" ] || continue
				echo "$flow_cnt" >"$rx_queue/rps_flow_cnt" 2>/dev/null || true
			done
		fi

		for tx_queue in "$iface"/queues/tx-*; do
			[ -f "$tx_queue/xps_cpus" ] || continue
			echo "$cpu_mask" >"$tx_queue/xps_cpus" 2>/dev/null || true
		done
	done
}

# 启动时按顺序应用 CPU、Intel P-State、网络栈、IRQ、网卡硬件/UDP GRO、队列分流调优。
start() {
	apply_cpu_governor
	apply_intel_pstate_tweaks
	apply_sysctl_tweaks
	apply_irq_affinity_defaults
	apply_nic_hardware_tuning
	apply_queue_tuning
}

# 重启服务时直接复用启动逻辑，保证参数被重新写回。
restart() {
	start
}
